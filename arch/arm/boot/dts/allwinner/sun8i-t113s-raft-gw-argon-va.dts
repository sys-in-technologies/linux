#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pwm/pwm.h>

/dts-v1/;

#include "sun8i-t113s.dtsi"

/ {
	model = "Raft Gataway ARGON VA";
	compatible = "allwinner,sun8i-t113s";

	aliases {
                serial0 = &uart0;
	};

        chosen {
               stdout-path = "serial0:115200n8";
        };

	/* board wide 5V supply directly from DC input */
	reg_vcc5v: regulator-5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
	
	/* AMS1117-3.3 regulator on the board */
	reg_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_vcc5v>;
	};

	/* EA3036C DC/DC regulator on the board, also supplying VDD-SYS */
	reg_vcc_core: regulator-core {
		compatible = "regulator-fixed";
		regulator-name = "vcc-core";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&reg_vcc5v>;
	};

	/* XC6206 LDO on the board */
	reg_avdd2v8: regulator-avdd {
		compatible = "regulator-fixed";
		regulator-name = "avdd2v8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		vin-supply = <&reg_3v3>;
	};

	/* just for goodix-ts compatible */
	ts_avdd28 {
		compatible = "regulator-fixed";
		regulator-name = "AVDD28";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_vcc5v>;
	};

	/* just for goodix-ts compatible */
	ts_vddio {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_vcc5v>;
	};

	watchdog {
		compatible = "allwinner,sun20i-d1-wdt";
		reg = <0x020500A0 0x20>;
	};

	user-gpios {
                compatible = "allwinner,sunxi-user-gpios";
//		pinctrl-names = "default";
//		pinctrl-0 = <&tp_pwr_pin>;

		//mesh-pwr-gpios = <&pio 2 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		//wifi-pwr-gpios = <&pio 2 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		//4g-pwr-gpios = <&pio 2 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		//4g-rst-gpios = <&pio 2 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		tp-pwr-gpios = <&pio 3 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
                //ephy-rst-gpios = <&pio 6 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		//nd-full-gpios = <&pio 3 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		//nd-empty-gpios = <&pio 3 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		//nd-mode-gpios = <&pio 3 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	};

	pwm: pwm@2000c00 {
		compatible = "allwinner,sun8i-h3-pwm";
		reg = <0x02000c00 0x400>;
		clocks = <&dcxo>;
		#pwm-cells = <3>;
		status = "okay";
	};

	backlight: backlight {
		   compatible = "pwm-backlight";
		   pwms = <&pwm 0 100000 PWM_POLARITY_INVERTED>;
		   power-supply = <&reg_vcc5v>;
		   /* gpio not connect to real backligth */
		   enable-gpios = <&pio 4 0 GPIO_ACTIVE_HIGH>;
		   brightness-levels = <0 30 40 50 60 70 80 90 100>;
		   default-brightness-level = <8>;
	};

	

};

&pio {
	vcc-pb-supply = <&reg_3v3>;
	vcc-pd-supply = <&reg_3v3>;
	vcc-pe-supply = <&reg_avdd2v8>;
	vcc-pf-supply = <&reg_3v3>;
	vcc-pg-supply = <&reg_3v3>;

        rmii_pg_pins: rmii-pg-pins {
	        pins = "PG0", "PG1", "PG2", "PG3", "PG4",
	        "PG5", "PG12", "PG13", "PG14", "PG15";
	        function = "emac";
        };

	uart1_pins: uart1-pins {
		pins = "PE10", "PE11";
		function = "uart1";
	};

	i2c2_pins: i2c2-pins {
		pins = "PD20", "PD21";
		function = "i2c2";
	};

	i2c3_pins: i2c3-pins {
		pins = "PE6", "PE7";
		function = "i2c3";
	};

	spi1_pins: spi1-pins {
		pins = "PD10", "PD11", "PD12", "PD13";
		function = "spi1";
	};

	pwm_pin: pwm-pin {
		pins = "PD17";
		function = "pwm";
	};

	/* for normal gpios */
//	mesh_pwr_pin: mesh-pwr-pin {
//		pins = "PC6";
//		function = "gpio_out";
//		bias-pull-up;
//	};
//
//	wifi_pwr_pin: wifi-pwr-pin {
//		pins = "PC7";
//		function = "gpio_out";
//		bias-pull-down; 
//	};
//
//	_4g_pwr_pin: 4g-pwr-pin {
//		pins = "PC3";
//		function = "gpio_out";
//		bias-pull-up; 
//	};
//	
//	_4g_rst_pin: 4g-rst-pin {
//		pins = "PC2";
//		function = "gpio_out";
//		bias-pull-up;
//	};
//
//	tp_pwr_pin: tp-pwr-pin {
//		pins = "PD18";
//		function = "gpio_out";
//		bias-pull-down;
//	};
//
//	ephy_rst_pin: ephy-rst-pin {
//		pins = "PG9";
//		function = "gpio_out";
//		bias-pull-down;
//	};
//
//	nd_full_pin: nd-full-pin {
//		pins = "PD16";
//		function = "gpio_in";
//		bias-pull-up;
//	};
//
//	nd_empty_pin: nd-empty-pin {
//		pins = "PD15";
//		function = "gpio_in";
//		bias-pull-up;
//	};
//
//	nd_mode_pin: nd-mode-pin {
//		pins = "PD14";
//		function = "gpio_in";
//		bias-pull-up;
//	};
};

&cpu0 {
	cpu-supply = <&reg_vcc_core>;
};

&cpu1 {
	cpu-supply = <&reg_vcc_core>;
};

&dcxo {
	clock-frequency = <24000000>;
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pe_pins>;
	status = "okay";
};

&uart1 {
        pinctrl-names = "default";
        pinctrl-0 = <&uart1_pins>;
        status = "okay";
};

&mmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins>;
	vmmc-supply = <&reg_3v3>;
	disable-wp;
	bus-width = <4>;
	status = "okay";
};

&emac {
	compatible = "allwinner,sun50i-h6-emac";
	pinctrl-names = "default";
	pinctrl-0 = <&rmii_pg_pins>;
	clocks = <&ccu CLK_BUS_EMAC>, <&ccu CLK_EMAC_25M>;
	clock-names = "stmmaceth", "pclk";
	phy-mode = "rmii";
	phy-handle = <&phy0>;
	phy-supply = <&reg_3v3>; 
	allwinner,tx-delay-ps = <300>;
	status = "okay";
};

&mdio {
        phy0: ethernet-phy@0 {
                reg=<0>;
                motorcomm,clk-out-frequency-hz = <0>;
                motorcomm,auto-sleep-disabled;
                motorcomm,keep-pll-enabled;
        };
};

&usbphy {
	usb1_vbus-supply = <&reg_vcc5v>;
	status = "okay";
};

&ehci0 {
        status = "okay";
};

&ohci0 {
        status = "okay";
};

&ehci1 {
        status = "okay";
};

&ohci1 {
        status = "okay";
};

&usb_otg {
        status = "disable";
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;

	touchscreen@5d {
            compatible = "goodix,gt911";
            reg = <0x5d>;
            interrupt-parent = <&pio>;
            interrupts = <3 22 IRQ_TYPE_EDGE_FALLING>;
            irq-gpios = <&pio 3 22 GPIO_ACTIVE_HIGH>;
            reset-gpios = <&pio 3 19 GPIO_ACTIVE_LOW>;
            touchscreen-swapped-x-y;
    };
};

&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;

	24c04@50 {
		compatible = "atmel,24c04";
		reg = <0x50>;
		pagesize = <16>;
		size = <512>;
	};

	rx8010@32{
		compatible = "epson,rx8010";
		reg = <0x32>;
	};
};

&spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
};

&dsi {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "huadichuangxian,hd50004c30", "ilitek,ili9881c";
		reg = <0>;
		power-supply = <&reg_avdd2v8>;
		reset-gpios = <&pio 4 1 GPIO_ACTIVE_HIGH>;
		backlight = <&backlight>;
	};
};

